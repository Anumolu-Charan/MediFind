# MediFind Application Environment Variables Example
PORT=5000
NODE_ENV=development

# Supabase PostgreSQL & Realtime Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key_here

# Authentication
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long

# AI Medicine Search (Backend Only)
GEMINI_API_KEY=your_google_gemini_api_key_here

# Maps & Places (Optional - Seeded pharmacies fallback provided if omitted)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
